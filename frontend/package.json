{
  "name": "@aptohire/university-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5175 --strictPort",
    "build": "tsc -b && vite build && node scripts/security-check.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4175",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_REF > src/lib/database.types.ts"
  },
  "dependencies": {
    "@aptohire/university-backend": "1.0.0",
    "@fontsource-variable/bricolage-grotesque": "5.1.1",
    "@fontsource-variable/instrument-sans": "5.1.1",
    "@fontsource/jetbrains-mono": "5.1.1",
    "@hookform/resolvers": "3.9.1",
    "@tanstack/react-query": "5.62.11",
    "@tanstack/react-table": "8.20.6",
    "lucide-react": "0.468.0",
    "papaparse": "5.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet-async": "2.0.5",
    "react-hook-form": "7.54.2",
    "react-router-dom": "7.18.4",
    "recharts": "2.15.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/papaparse": "5.3.15",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.30",
    "tailwindcss": "3.4.19",
    "typescript": "5.7.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
